# EstateVista Backend & Supabase Configuration
PORT=5000
APP_ORIGIN=http://localhost:5173

# 1. Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase API Keys (Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Direct PostgreSQL connection URL for `npm run db:migrate`
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# 4. Session signing secret. Required in production; use a long random value.
SESSION_SECRET=replace-with-a-long-random-string

# 5. First company and admin, used once by `npm run db:seed`.
#    Leave SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD unset to skip auth seeding.
SEED_COMPANY_NAME=Your Company
SEED_COMPANY_SLUG=your-company
SEED_COMPANY_EMAIL=hello@your-company.test
SEED_ADMIN_NAME=Workspace Admin
SEED_ADMIN_EMAIL=admin@your-company.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_CURRENCY=USD
SEED_TIMEZONE=UTC
SEED_DATE_FORMAT=YYYY-MM-DD
SEED_NUMBER_DECIMALS=2

# Set to true only to reset an existing seeded admin password on the next seed.
# SEED_RESET_ADMIN_PASSWORD=false
