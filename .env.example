# EstateVista Backend & Supabase Configuration
PORT=5000

# 1. Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase API Keys (Find in: Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. (Optional) Direct PostgreSQL Connection URL (Find in: Project Settings -> Database)
# DATABASE_URL=postgresql://postgres.your-ref:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
